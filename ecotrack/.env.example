# ==========================================
# EcoTrack - Environment Configuration
# ==========================================

# Node.js Backend Server
PORT=5000

# MongoDB Connection String
# (Standard local instance or MongoDB Atlas cloud URI)
# If left as is and local mongod is offline, EcoTrack automatically activates
# a local embedded persistence fallback so it runs out of the box.
MONGODB_URI=mongodb://127.0.0.1:27017/ecotrack

# Python / Flask Calculation Microservice
FLASK_PORT=5001
FLASK_SERVICE_URL=http://127.0.0.1:5001
